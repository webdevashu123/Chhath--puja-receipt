# Server Port
PORT=5000
NODE_ENV=development

# CORS Allowed Origin (set to frontend domain or * in production)
ORIGIN=http://localhost:5173

# Admin PIN bcrypt hash (Default hash corresponds to PIN: 2026)
# Generate a new hash with: node scripts/hash-pin.js <PIN>
ADMIN_PIN_HASH=$2b$10$tAsGY5oFYr7ehZKA8HTVN.EBBudbBjpH5Aom1eiUzEnyojhO/iWYi

# JWT Secret for admin authentication cookies
JWT_SECRET=chhath-puja-samiti-super-secret-jwt-key-2026

# Public Base URL for receipt share links (/r/:token)
PUBLIC_BASE_URL=http://localhost:5000

# Path to system Chrome/Chromium binary (optional; Puppeteer downloads its own Chrome if omitted)
# In Docker or Linux VPS: /usr/bin/chromium or /usr/bin/google-chrome
CHROME_PATH=

# WhatsApp Cloud API (Optional, disabled by default)
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
